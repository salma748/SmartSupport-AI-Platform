@{
    var customer = User.IsInRole("Customer");
    ViewData["Title"] = customer ? "Support chat" : "Agent workspace";
}
<div id="support" data-customer="@(customer ? "true" : "false")" data-root="@Url.Action("Index", "Support")" data-hub="@Url.Content("~/support-live")">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <form asp-action="Logout" method="post"><button class="btn btn-outline-secondary">Sign out</button></form>
    </div>
    <div id="desk-error" class="alert alert-danger" role="alert" hidden></div>
    <div class="row g-3">
        <aside class="col-md-4">
            <div class="card p-3">
                @if (customer)
                {
                    <button id="start-thread" class="btn btn-primary mb-3">New conversation</button>
                    <h2 class="h6">Conversations</h2>
                    <div id="threads" class="list-group mb-3"></div>
                }
                <h2 class="h6">Support tickets</h2>
                <div id="tickets" class="list-group"></div>
            </div>
        </aside>
        <section class="col-md-8">
            <div class="card shadow-sm p-3">
                <div class="d-flex justify-content-between gap-2">
                    <h2 id="thread-name" class="h5">Select a conversation</h2>
                    <span id="connection" class="small text-muted" role="status">Connecting…</span>
                </div>
                <div id="ticket-context" class="small text-muted" style="white-space: pre-wrap"></div>
                <div id="chat-log" class="support-log" role="log" aria-label="Conversation messages" tabindex="0"></div>
                <div id="activity" class="small text-muted mb-2" role="status"></div>
                <form id="send-message" hidden>
                    <label for="message" class="form-label">Message</label>
                    <div class="input-group">
                        <input id="message" name="message" class="form-control" maxlength="2000" required />
                        <button class="btn btn-primary">Send</button>
                    </div>
                </form>
                @if (customer)
                {
                    <form id="refund-form" class="alert alert-warning my-3" hidden>
                        <p id="refund-summary"></p>
                        <label for="refund-reason" class="form-label">Reason for requesting a refund</label>
                        <input id="refund-reason" name="reason" class="form-control" maxlength="2000" required />
                        <button class="btn btn-dark mt-2">Confirm refund request</button>
                    </form>
                    <form id="feedback-form" class="mt-3 d-flex gap-2 align-items-center" hidden>
                        <label for="rating">Rate your support</label>
                        <select id="rating" name="rating" class="form-select w-auto">
                            @for (int i = 1; i <= 5; i++) { <option value="@i">@i</option> }
                        </select>
                        <button class="btn btn-outline-secondary">Save rating</button>
                    </form>
                }
                else
                {
                    <details id="agent-details" class="mt-3" hidden>
                        <summary>Ticket history, private notes, and tool outcomes</summary>
                        <div id="agent-detail-items" style="white-space: pre-wrap"></div>
                    </details>
                    <form id="note-form" class="mt-3" hidden>
                        <label for="note" class="form-label">Private note</label>
                        <input id="note" name="note" class="form-control" maxlength="2000" required />
                        <button class="btn btn-outline-secondary mt-2">Save note</button>
                        <button type="button" id="resolve" class="btn btn-outline-success mt-2">Resolve ticket</button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>
@section Scripts {
    <script src="~/js/support.js" asp-append-version="true"></script>
}
